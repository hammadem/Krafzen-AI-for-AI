# Hugging Face Configuration
# Copy this file to .env and fill in your values
# The .env file is gitignored and will not be committed

HF_TOKEN=your_huggingface_token_here

# Hugging Face username
HF_USERNAME=your_huggingface_username

# Hugging Face Fine Tuned Model Name
HF_FINE_TUNED_MODEL_NAME=your_huggingface_fine_tuned_model_name

# Adapter path (optional - defaults to cad-agent-qwen-2d in workspace directory)
# Can be absolute path, relative path, or use $HOME or ~ for home directory
# Examples:
# ADAPTER_PATH=cad-agent-qwen-2d
# ADAPTER_PATH=/workspace/cad-agent-qwen-2d
# ADAPTER_PATH=/workspace/cadllm
# ADAPTER_PATH=$HOME/Projects/models
# ADAPTER_PATH=~/Projects/models
ADAPTER_PATH=$HOME/Projects/models
