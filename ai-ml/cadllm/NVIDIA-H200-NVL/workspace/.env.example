# Hugging Face Configuration
# Copy this file to .env and fill in your values
# The .env file is gitignored and will not be committed

HF_TOKEN=your_huggingface_token_here

# Hugging Face username
HF_USERNAME=your_huggingface_username

# Hugging Face Fine Tuned Model Name
HF_FINE_TUNED_MODEL_NAME=your_huggingface_fine_tuned_model_name

# Base model to train on
BASE_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct

# Adapter path
ADAPTER_PATH=$HOME/Projects/models/cadllm-adapter

# Model output path
MODEL_OUTPUT_DIR=$HOME/Projects/models/cadllm

# Model output path
MODEL_PATH=$HOME/Projects/models/cadllm

# To Deploy Model in Ollama (local server)
GGUF_OUTPUT_DIR=$HOME/Projects/models/ollama-models

# Use Mac MPS Graphics Card
USE_MPS=false

# LLAMA CPP PATH
LLAMA_CPP_PATH=$HOME/Projects/llama.cpp