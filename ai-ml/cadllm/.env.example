# =============================================================================
# CADLLM Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed to version control
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your actual values
# =============================================================================

# =============================================================================
# Hugging Face Configuration (Required for model upload and API access)
# =============================================================================

# Your Hugging Face API token
# Get it from: https://huggingface.co/settings/tokens
# Required for: upload_model.py, upload_dataset.py, test_hf_api.py
HF_TOKEN=your_huggingface_token_here

# Your Hugging Face username/organization name
# This will be used to create repositories like: username/model-name
# Required for: upload_model.py, upload_dataset.py
HF_USERNAME=your_huggingface_username

# Name for your fine-tuned model repository on Hugging Face
# This will be combined with HF_USERNAME to create: username/HF_FINE_TUNED_MODEL_NAME
# Example: cadllm-qwen-3b-instruct
# Required for: upload_model.py
HF_FINE_TUNED_MODEL_NAME=your_huggingface_fine_tuned_model_name

# Optional: Full model name (username/model-name)
# If set, this takes precedence over HF_USERNAME/HF_FINE_TUNED_MODEL_NAME
# Used by: test_hf_api.py, cadllm_client.py
# HF_MODEL_NAME=your-username/your-model-name

# Optional: Hugging Face Inference Endpoint URL
# Only needed if you create a dedicated Inference Endpoint
# Leave unset to use the standard Inference API (recommended for most users)
# To get an endpoint URL:
#   1. Go to https://huggingface.co/inference-endpoints
#   2. Create a new endpoint for your model
#   3. Copy the endpoint URL
# Used by: test_hf_api.py
# HF_ENDPOINT_URL=https://xxx.us-east-1.aws.endpoints.huggingface.cloud

# Repository privacy setting (optional, default: true)
# Set to "false" to make repositories public
# Used by: upload_model.py
HF_REPO_PRIVATE=true

# =============================================================================
# Model Training & Fine-tuning Configuration
# =============================================================================

# Base model identifier from Hugging Face
# This is the pre-trained model that will be fine-tuned
# Default: Qwen/Qwen2.5-Coder-3B-Instruct
# Required for: merge_model.py, upload_model.py
BASE_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct

# Path to LoRA adapter directory (output from training)
# This is the checkpoint directory created during fine-tuning
# Example: /workspace/cadllm/checkpoint-21000 or $HOME/Projects/models/cadllm-adapter
# Required for: merge_model.py
ADAPTER_PATH=$HOME/Projects/models/cadllm-adapter

# =============================================================================
# Model Management Configuration
# =============================================================================

# Path to merged model directory (output from merge_model.py)
# This is where the merged model will be saved after combining LoRA adapter with base model
# Also used by upload_model.py and deploy_ollama.py
# Example: $HOME/Projects/models/cadllm
# Required for: merge_model.py, upload_model.py, deploy_ollama.py
MODEL_PATH=$HOME/Projects/models/cadllm

# =============================================================================
# Dataset Configuration
# =============================================================================

# Path to dataset JSONL file
# This is the processed training dataset in JSONL format
# Example: ./dataset/jsonl/cadllm.jsonl or /workspace/dataset/jsonl/cadllm.jsonl
# Required for: upload_dataset.py
DATASET_PATH=./dataset/jsonl/cadllm.jsonl

# Dataset name for Hugging Face repository
# This will be combined with HF_USERNAME to create: username/dataset-name
# Example: cadllm-dataset
# Required for: upload_dataset.py
HF_DATASET_NAME=cadllm-dataset

# Dataset privacy setting (optional, default: true)
# Set to "false" to make dataset repository public
# Used by: upload_dataset.py
HF_DATASET_PRIVATE=true

# =============================================================================
# Ollama Deployment Configuration (Optional, for local inference)
# =============================================================================

# Name for the Ollama model
# This is the name you'll use with `ollama run <name>`
# Default: cadllm
# Used by: deploy_ollama.py, infer_local_mac.py, test_hf_api.py
OLLAMA_MODEL_NAME=cadllm

# Ollama server base URL
# Default: http://localhost:11434
# Change this if Ollama is running on a different host/port
# Used by: infer_local_mac.py, test_hf_api.py
OLLAMA_BASE_URL=http://localhost:11434

# Output directory for GGUF files (converted model format for Ollama)
# This is where the converted GGUF model file will be saved
# Default: ./scripts/deployment/ollama-models
# Used by: deploy_ollama.py
GGUF_OUTPUT_DIR=$HOME/Projects/models/ollama-models

# Path to llama.cpp root directory
# Required for converting Hugging Face models to GGUF format
# After cloning llama.cpp from https://github.com/ggerganov/llama.cpp:
#   git clone https://github.com/ggerganov/llama.cpp.git
#   cd llama.cpp && mkdir build && cd build && cmake .. && cmake --build .
# Then set this to the root of the cloned directory (e.g., $HOME/llama.cpp)
# The script will auto-detect Homebrew installations if not set
# Used by: deploy_ollama.py
LLAMA_CPP_PATH=$HOME/Projects/llama.cpp

# =============================================================================
# Hardware Configuration (Optional)
# =============================================================================

# Use Mac MPS (Metal Performance Shaders) for GPU acceleration
# Set to "true" to enable MPS on Apple Silicon Macs
# Note: MPS has memory limitations, CPU may be more stable for large models
# Default: false (uses CPU)
# Used by: infer.py (if modified to support MPS)
USE_MPS=false

# =============================================================================
# Hugging Face Space Deployment Configuration (Optional)
# =============================================================================

# Space repository identifier (username/repo-name)
# Example: mkmad7/cad-llm-api
# Used by: deploy_space.py
HF_SPACE_REPO=username/your_HF_space_repo_name

# =============================================================================
# Notes
# =============================================================================
# - All paths support environment variable expansion (e.g., $HOME, ~)
# - All paths support both absolute and relative paths
# - Relative paths are resolved relative to the script's directory
# - Required variables must be set before running the corresponding scripts
# - Optional variables have defaults and can be omitted
# - See README.md for detailed usage instructions for each script
