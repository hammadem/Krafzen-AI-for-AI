# ============================================================================
# STAGING – Frontend: https://staging.krafzen.com | Backend: https://backend.staging.krafzen.com
# ============================================================================
# Use these values in Vercel (Staging env) and Render (staging backend).
# Stripe: TEST keys only. Supabase: add https://staging.krafzen.com/** to Redirect URLs.

# ============================================================================
# Application Settings (Backend)
# ============================================================================
ENVIRONMENT=staging
DEBUG=false
PORT=8000

# ============================================================================
# Supabase Configuration (same project; add staging redirect in Dashboard)
# ============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# CORS & API Configuration – STAGING
# ============================================================================
# Comma-separated; must include staging frontend and localhost for dev
ALLOWED_ORIGINS=https://staging.krafzen.com,https://krafzen-ai-staging.vercel.app,http://localhost:3000
# Frontend: set in Vercel Staging env
NEXT_PUBLIC_API_URL=https://backend.staging.krafzen.com

# ============================================================================
# Gemini / CAD LLM / DXF (same as production or dev)
# ============================================================================
GEMINI_API_KEY=
USE_GEMINI_FOR_IMAGE=
HF_TOKEN=
HF_ENDPOINT_URL=
HF_MODEL_NAME=
DXF_GENERATION_METHOD=
MAX_FILE_SIZE_MB=
ALLOWED_AUDIO_FORMATS=

# ============================================================================
# Database (Migration Script)
# ============================================================================
SUPABASE_DATABASE_URL=
SUPABASE_PASSWORD=

# ============================================================================
# Stripe – STAGING: TEST keys only (no real charges)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_LIVE_MODE=false

# ============================================================================
# Third Party
# ============================================================================
NEXT_PUBLIC_CALENDLY_URL=
