# ============================================================================
# KRAFZEN AI - Unified Environment Configuration
# ============================================================================
# This file contains sensitive credentials for both Frontend and Backend
# location: .env (Root)

# ============================================================================
# Application Settings (Backend)
# ============================================================================
ENVIRONMENT=
DEBUG=
PORT=

# ============================================================================
# Supabase Configuration
# ============================================================================
# Shared Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend Specific
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_ID=

# Frontend Specific (Matched)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# CORS & API Configuration
# ============================================================================
ALLOWED_ORIGINS=
NEXT_PUBLIC_API_URL=



# ============================================================================
# Gemini Configuration
# ============================================================================
GEMINI_API_KEY=
USE_GEMINI_FOR_IMAGE=

# ============================================================================
# CADLLM Configuration
# ============================================================================

# Hugging Face
HF_TOKEN=
HF_ENDPOINT_URL=
HF_MODEL_NAME=

# Ollama
#OLLAMA_BASE_URL=
#OLLAMA_MODEL=

# ============================================================================
# DXF Generation Configuration
# ============================================================================
DXF_GENERATION_METHOD=
DWG_CONVERTER_TYPE=ODA
# Example macOS app binary path:
# DWG_CONVERTER_CMD=/Applications/ODAFileConverter.app/Contents/MacOS/ODAFileConverter
DWG_CONVERTER_CMD=
# Render/Docker Linux build: HTTPS URL to official ODA Linux x64 .deb (secret; do not commit real URL with token)
# DWG_ODA_DEB_URL=
MAX_FILE_SIZE_MB=
ALLOWED_AUDIO_FORMATS=

# ============================================================================
# Vercel Configuration (Optional/Local)
# ============================================================================
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ============================================================================
# Database Configuration (Migration Script)
# ============================================================================
SUPABASE_DATABASE_URL=
SUPABASE_PASSWORD=

# ============================================================================
# Stripe Payment Configuration
# ============================================================================
# Use TEST keys (pk_test_..., sk_test_...) for: local, Vercel Preview, Vercel Development.
# Use LIVE keys (pk_live_..., sk_live_...) ONLY for Vercel Production (real payments).
# Test cards: https://docs.stripe.com/testing (e.g. 4242 4242 4242 4242)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_100_MINS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to true only in Production backend (disables mock subscribe/activate endpoints).
STRIPE_LIVE_MODE=

# ============================================================================
# Dodo Payments Configuration
# ============================================================================
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_TEST_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_WEBHOOK_ENDPOINT_ID=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PRODUCT_ID_STARTER_MONTHLY=pdt_0NptIUxBB6ax8M2pe8Jc2
DODO_PRODUCT_ID_STARTER_ANNUAL=pdt_0NptIUnfunV7bYoJ9dtUE
DODO_PRODUCT_ID_PROFESSIONAL_MONTHLY=pdt_0NptIUuKMySW5tuz5FgRk
DODO_PRODUCT_ID_PROFESSIONAL_ANNUAL=pdt_0NptIUjvCnzjEpS7tZdLo
DODO_PRODUCT_ID_ENTERPRISE_MONTHLY=pdt_0NptIUsLytgIvdbPve7kh
