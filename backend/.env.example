# ============================================================================
# KRAFZEN AI - Backend Environment Configuration (TEMPLATE)
# ============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. It is already in .gitignore.

# ============================================================================
# Application Settings
# ============================================================================

# Environment: development, staging, or production
ENVIRONMENT=development

# Debug mode (True/False)
DEBUG=True

# Server port (default: 8000)
PORT=8000

# ============================================================================
# OpenAI API Configuration
# ============================================================================
# Required for AI transcription and parsing features
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================================
# Supabase Configuration
# ============================================================================
# Required for database operations
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (for client-side / frontend)
# Use this for frontend and backend when RLS (Row Level Security) is enabled
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for backend admin operations)
# Only use this in backend when you need to bypass RLS or perform admin operations
# NEVER expose this in frontend code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backward compatibility alias (maps to SUPABASE_ANON_KEY)
SUPABASE_KEY=your-anon-key-here

# JWT Secret (Supabase Dashboard > Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins for CORS
# Wildcards are supported (e.g., https://*.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.vercel.app

# ============================================================================
# Monitoring & Error Tracking
# ============================================================================
# Optional: Sentry DSN for error tracking and monitoring
# Get your DSN from: https://sentry.io
SENTRY_DSN=

# ============================================================================
# GPT-4 Parser Configuration
# ============================================================================
# GPT-4 model name (default: gpt-4-turbo-preview or gpt-4)
GPT_MODEL=gpt-4-turbo-preview

# Maximum tokens for GPT-4 response
GPT_MAX_TOKENS=2000

# Temperature for GPT-4 (0.0-2.0, lower = more deterministic)
GPT_TEMPERATURE=0.3

# File upload limits
MAX_FILE_SIZE_MB=25
ALLOWED_AUDIO_FORMATS=mp3,wav,m4a,ogg,flac,webm

# ============================================================================
# Render.com Deployment Configuration (Optional)
# ============================================================================
# Only needed if deploying to Render.com
# These are used for managing deployments via API
RENDER_API_KEY=your-render-api-key
RENDER_SERVICE_ID_PRODUCTION=your_production_service_id
RENDER_SERVICE_ID_STAGING=your_staging_service_id

# ============================================================================
# GEMINI Configuration
# ============================================================================

# Free Tier Key
# GEMINI_API_KEY=your-gemini-key

# Paid Tier Key
GEMINI_API_KEY=your-gemini-key

# ============================================================================
# OLLAMA Configuration
# ============================================================================
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_NAME=cadllm

# ============================================================================
# Image Generation Configuration
# ============================================================================
USE_GEMINI_FOR_IMAGE=True
HF_TOKEN=hf_your-huggingface-token
HF_ENDPOINT_URL=hf_your-endpoint-url
HF_MODEL_NAME=hf_your-model-name

# ============================================================================
# DXF Generation Configuration
# ============================================================================
API_2_CONVERT_KEY=your-api2convert-key
API_2_CONVERT_URL=https://api.api2convert.com/v2

# DWG (Render build: optional secret DWG_ODA_DEB_URL = HTTPS URL to ODA Linux x64 .deb)
DWG_CONVERTER_TYPE=ODA
DWG_CONVERTER_CMD=ODAFileConverter
# DWG_ODA_DEB_URL=

# ==============================================================================
# DEFAULT / GLOBAL INFRASTRUCTURE CONFIGURATION
# ==============================================================================
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above are reused as the global defaults.
# (Do not define them a second time here: duplicates silently override each other.)
DEFAULT_STORAGE_BUCKET="dxf-files"
DEFAULT_STORAGE_REGION="us-east-1"

# ==============================================================================
# ENTERPRISE: US REGIONAL SOVEREIGN INFRASTRUCTURE
# ==============================================================================
# Regional Database Direct Connection URL
# Tip: URL-encode special characters in the password (@ -> %40, # -> %23, $ -> %24, ! -> %21)
SUPABASE_DATABASE_URL_US="postgresql://postgres:your-url-encoded-password@db.your-us-project.supabase.co:5432/postgres"

# Regional Object Storage Credentials & S3 Endpoint
SUPABASE_STORAGE_URL_US="https://your-us-project.supabase.co"
SUPABASE_STORAGE_KEY_US=your-us-storage-service-role-key
SUPABASE_STORAGE_REGION_US="us-east-1"
SUPABASE_STORAGE_BUCKET_US="krafzen-us-files"

# Regional Processing & Queue Configuration
US_QUEUE_NAME="krafzen-us-export-jobs"
US_WORKER_POOL="render-us-nodes"