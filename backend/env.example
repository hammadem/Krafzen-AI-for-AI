# KRAFZEN AI Backend Environment Variables

# Environment
ENVIRONMENT=development  # development, staging, production

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Database
SUPABASE_URL=https://oenktgnerfpwyouzihq.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Server Configuration
PORT=8000
DEBUG=False

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app,https://staging.krafzen.com,https://app.krafzen.com

# Monitoring
SENTRY_DSN=your_sentry_dsn_here

# Render Configuration (for production)
RENDER_SERVICE_ID_PRODUCTION=your_production_service_id
RENDER_SERVICE_ID_STAGING=your_staging_service_id
