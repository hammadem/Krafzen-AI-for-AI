# ============================================================================
# PRODUCTION – Frontend: https://krafzen.com | Backend: https://backend.krafzen.com
# ============================================================================
# Use these values in Vercel (Production env) and Render (production backend).
# Stripe: LIVE keys only. Supabase: Site URL + Redirect URLs for www.krafzen.com.

# ============================================================================
# Application Settings (Backend)
# ============================================================================
ENVIRONMENT=production
DEBUG=false
PORT=8000

# ============================================================================
# Supabase Configuration (same project; production redirects in Dashboard)
# ============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# CORS & API Configuration – PRODUCTION
# ============================================================================
# Comma-separated; production frontend only (no localhost)
ALLOWED_ORIGINS=https://www.krafzen.com,https://krafzen.com
# Frontend: set in Vercel Production env
NEXT_PUBLIC_API_URL=https://backend.krafzen.com

# ============================================================================
# Gemini / CAD LLM / DXF
# ============================================================================
GEMINI_API_KEY=
USE_GEMINI_FOR_IMAGE=
HF_TOKEN=
HF_ENDPOINT_URL=
HF_MODEL_NAME=
DXF_GENERATION_METHOD=
MAX_FILE_SIZE_MB=
ALLOWED_AUDIO_FORMATS=

# DWG (ODA File Converter on Linux). Recommended on Render: R2 API vars (see backend/docker/README.md).
DWG_CONVERTER_TYPE=ODA
DWG_CONVERTER_CMD=ODAFileConverter
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ODA_BUCKET=krafzen-build-private
# R2_ODA_OBJECT_KEY=ODAFileConverter_QT6_lnxX64_8.3dll_27.1.deb
# DWG_ODA_DEB_URL=  # optional presigned URL fallback (max 7 days)

# ============================================================================
# Database (Migration Script)
# ============================================================================
SUPABASE_DATABASE_URL=
SUPABASE_PASSWORD=

# ============================================================================
# Stripe – PRODUCTION: LIVE keys only (real payments)
# ============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_LIVE_MODE=true

# ============================================================================
# Third Party
# ============================================================================
NEXT_PUBLIC_CALENDLY_URL=
